# Copy to .env and fill in. .env is git-ignored.

APP_NAME=aivar
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# --- LLM providers -------------------------------------------------------
# At least one key is required. Every provider with a key present joins the
# failover chain, so configuring more than one makes a run survive a rate limit.
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
SARVAM_API_KEY=

# Which provider to use first: openrouter | google | sarvam.
# Unset means the first one that has a key, in that order.
AIVAR_LLM_PROVIDER=

# Models for the chosen provider, comma-separated. Unset means that provider's
# defaults: openrouter -> minimax/minimax-m3:free, nvidia/nemotron-3-super-120b-a12b:free
#           google     -> gemini-flash-latest
#           sarvam     -> sarvam-105b
AIVAR_LLM_MODELS=

# Per-provider overrides, if you want different models per provider.
# AIVAR_OPENROUTER_MODELS=
# AIVAR_GOOGLE_MODELS=
# AIVAR_SARVAM_MODELS=
# AIVAR_OPENROUTER_BASE_URL=
# AIVAR_GOOGLE_BASE_URL=
# AIVAR_SARVAM_BASE_URL=

# Set to 0 to keep a run on one provider instead of spilling over on failure.
AIVAR_LLM_FALLBACK=1

# --- Storage -------------------------------------------------------------
# Optional. Without it you lose run history, not runs.
AIVAR_DB_URL=

# --- Target --------------------------------------------------------------
AIVAR_TARGET_URL=
AIVAR_TARGET_NAME=default
AIVAR_VIEWPORT_WIDTH=1280
AIVAR_VIEWPORT_HEIGHT=720
AIVAR_HEADLESS=true

# Credentials injected into generated tests as ${AIVAR_USERNAME} placeholders.
AIVAR_USERNAME=
AIVAR_PASSWORD=

# --- Guardrails ----------------------------------------------------------
# AIVAR_HEAL_ASSERTIONS is deliberately absent and unreadable: a failing
# assertion is a candidate bug, not a candidate repair. See AGENTS.md.
AIVAR_MAX_HEALS_PER_RUN=3
AIVAR_MIN_HEAL_CONFIDENCE=0.5
AIVAR_REQUIRE_SEMANTIC_MATCH=true
AIVAR_MAX_COST_PER_RUN_USD=0.50
AIVAR_ACTION_RETRIES=2
AIVAR_ACTION_TIMEOUT_MS=8000
